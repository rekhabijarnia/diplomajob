rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Job applications
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if true; // Allow diploma candidates to apply directly
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // Recruiter posted jobs
    match /postedJobs/{jobId} {
      allow read: if true; // Public listings so diploma freshers can view
      allow create: if true;
      allow update, delete: if true;
    }

    // Fraud reports (Zero-fee anti-fraud defense)
    match /fraudReports/{reportId} {
      allow read: if true;
      allow create: if true; // Anyone can report an illegal fee demand
      allow update, delete: if true;
    }

    // Saved jobs bookmarks
    match /savedJobs/{savedJobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Chat conversations log
    match /chatConversations/{chatId} {
      allow create: if true;
      allow read: if isAuthenticated();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
